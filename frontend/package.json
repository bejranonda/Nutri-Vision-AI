{
  "name": "eatinorder",
  "version": "2.1.11",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @opennextjs/cloudflare build --dangerouslyUseUnsupportedNextVersion && node scripts/prepare-pages.mjs",
    "preview": "npm run pages:build && npx @opennextjs/cloudflare preview",
    "deploy": "npm run pages:build && npx wrangler pages deploy ./.open-next/assets --project-name=eatinorder --commit-dirty=true",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:all": "npm run type-check && npm run check:i18n && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-tabs": "^1.0.4",
    "@tanstack/react-query": "^5.32.0",
    "axios": "^1.6.8",
    "country-flag-icons": "^1.6.15",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.378.0",
    "next": "14.2.3",
    "next-intl": "^3.26.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.6",
    "zod": "^4.3.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.16.6",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.31.9",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5",
    "wrangler": "^4.67.0"
  }
}
