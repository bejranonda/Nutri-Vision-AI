{
  "name": "@nutrivision/nutrivision-ai",
  "version": "2.1.14",
  "description": "AI-powered nutrition analysis and recipe assistant specialized in Thai cuisine. Full-stack application with Next.js frontend and FastAPI backend.",
  "keywords": [
    "nutrition",
    "ai",
    "food-recognition",
    "recipe",
    "health",
    "thai-cuisine",
    "nextjs",
    "fastapi",
    "nutrition-analysis",
    "food-scanner",
    "gemini-ai",
    "wellness",
    "meal-planning",
    "nutrition-scoring"
  ],
  "homepage": "https://github.com/bejranonda/Nutri-Vision-AI#readme",
  "bugs": {
    "url": "https://github.com/bejranonda/Nutri-Vision-AI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bejranonda/Nutri-Vision-AI.git"
  },
  "license": "MIT",
  "author": {
    "name": "NutriVision AI",
    "email": "support@nutrivision.app"
  },
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:docker": "docker-compose up",
    "build": "cd frontend && npm run build",
    "pages:build": "npm run pages:build -w frontend",
    "preview": "npm run preview -w frontend",
    "deploy": "npm run deploy -w frontend",
    "type-check": "cd frontend && npx tsc --noEmit",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint -- --fix",
    "clean": "rm -rf frontend/.next frontend/node_modules node_modules"
  },
  "files": [
    "frontend/",
    "backend/",
    "scripts/",
    "docker/",
    "docker-compose.yml",
    ".env.example",
    "README.md",
    "README-TH.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "PUBLISHING.md",
    "DEPLOYMENT.md",
    "PROJECT_PLAN.md"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {}
}
